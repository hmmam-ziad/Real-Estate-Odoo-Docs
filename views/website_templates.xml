<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================ -->
    <!-- Property List — with search / filter form                        -->
    <!-- ================================================================ -->
    <template id="property_list_template" name="Property List">
        <t t-call="website.layout">
            <div class="container my-5">
                <h1 class="mb-4">Available Properties</h1>

                <!-- Search & Filter Bar -->
                <form method="get" action="/estate/properties"
                    class="row g-2 mb-4 align-items-end estate-filter-form">
                    <div class="col-md-3">
                        <label class="form-label small text-muted">Search</label>
                        <input type="text" name="search" class="form-control"
                            placeholder="Property name..."
                            t-att-value="filters.get('search') or ''" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small text-muted">Type</label>
                        <select name="property_type" class="form-select">
                            <option value="">Any type</option>
                            <t t-foreach="property_types" t-as="ptype">
                                <option t-att-value="ptype.id"
                                    t-att-selected="'selected' if str(filters.get('property_type')) == str(ptype.id) else None">
                                    <t t-esc="ptype.name" />
                                </option>
                            </t>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small text-muted">Min bedrooms</label>
                        <input type="number" name="bedrooms" min="0" class="form-control"
                            t-att-value="filters.get('bedrooms') or ''" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small text-muted">Min price</label>
                        <input type="number" name="min_price" min="0" class="form-control"
                            t-att-value="filters.get('min_price') or ''" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small text-muted">Max price</label>
                        <input type="number" name="max_price" min="0" class="form-control"
                            t-att-value="filters.get('max_price') or ''" />
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary mt-2">
                            <i class="fa fa-search me-1" /> Filter </button>
                        <a href="/estate/properties" class="btn btn-outline-secondary mt-2">Reset</a>
                    </div>
                </form>

                <p class="text-muted" t-if="not properties">
                    No properties match your search. Try widening your filters.
                </p>

                <div class="row">
                    <t t-foreach="properties" t-as="prop">
                        <div class="col-md-4 mb-4">
                            <div class="card h-100 shadow-sm">
                                <img t-if="prop.image_1920"
                                    t-att-src="'/web/image/estate.property/%s/image_1920' % prop.id"
                                    class="card-img-top" style="height:200px;object-fit:cover;"
                                    t-att-alt="prop.name" />
                                <div t-else=""
                                    class="card-img-top d-flex align-items-center justify-content-center bg-light"
                                    style="height:200px;">
                                    <i class="fa fa-home fa-3x text-muted" />
                                </div>
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title">
                                        <t t-esc="prop.name" />
                                    </h5>
                                    <p class="text-muted mb-1">
                                        <i class="fa fa-bed me-1" /> <t t-esc="prop.bedrooms" /> beds
                                        &#183; <i class="fa fa-arrows-alt me-1" /> <t
                                            t-esc="prop.living_area" /> sqm </p>
                                    <p class="card-text fw-bold text-primary mb-3">
                                        <span t-field="prop.expected_price"
                                            t-options="{'widget': 'monetary', 'display_currency': prop.currency_id}" />
                                    </p>
                                    <a t-attf-href="/estate/property/#{prop.id}"
                                        class="btn btn-primary btn-sm mt-auto">
                                        View Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>


    <!-- ================================================================ -->
    <!-- Property Detail — with AJAX "Make an Offer" form                 -->
    <!-- ================================================================ -->
    <template id="property_detail_template" name="Property Detail">
        <t t-call="website.layout">
            <div class="container my-5" t-att-data-property-id="property.id">
                <a href="/estate/properties" class="btn btn-outline-secondary mb-3">
                    <i class="fa fa-arrow-left me-1" /> Back to List </a>

                <div class="row">
                    <div class="col-md-7">
                        <img t-if="property.image_1920"
                            t-att-src="'/web/image/estate.property/%s/image_1920' % property.id"
                            class="img-fluid rounded shadow-sm mb-4"
                            style="width:100%;max-height:420px;object-fit:cover;"
                            t-att-alt="property.name" />
                        <div t-else=""
                            class="d-flex align-items-center justify-content-center bg-light rounded mb-4"
                            style="height:300px;">
                            <i class="fa fa-home fa-5x text-muted" />
                        </div>

                        <h2>
                            <t t-esc="property.name" />
                        </h2>
                        <p t-if="property.tag_ids" class="mb-3">
                            <t t-foreach="property.tag_ids" t-as="tag">
                                <span class="badge bg-secondary me-1">
                                    <t t-esc="tag.name" />
                                </span>
                            </t>
                        </p>
                        <p t-if="property.description" t-esc="property.description" />

                        <hr />
                        <div class="row text-center mb-4">
                            <div class="col-3">
                                <div class="fw-bold">
                                    <t t-esc="property.bedrooms" />
                                </div>
                                <div class="small text-muted">Bedrooms</div>
                            </div>
                            <div class="col-3">
                                <div class="fw-bold"><t t-esc="property.living_area" /> sqm</div>
                                <div class="small text-muted">Living Area</div>
                            </div>
                            <div class="col-3">
                                <div class="fw-bold">
                                    <t t-esc="property.facades" />
                                </div>
                                <div class="small text-muted">Facades</div>
                            </div>
                            <div class="col-3">
                                <div class="fw-bold">
                                    <t t-esc="'Yes' if property.garage else 'No'" />
                                </div>
                                <div class="small text-muted">Garage</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-5">
                        <div class="card shadow-sm mb-4">
                            <div class="card-body">
                                <div class="text-muted small">Expected Price</div>
                                <div class="h3 text-primary fw-bold mb-3">
                                    <span t-field="property.expected_price"
                                        t-options="{'widget': 'monetary', 'display_currency': property.currency_id}" />
                                </div>

                                <!-- Interactive offer form: submitted via fetch(), no page reload -->
                                <t t-if="can_offer">
                                    <div id="estate_offer_feedback" class="alert d-none"
                                        role="alert"></div>
                                    <form id="estate_offer_form" class="estate-offer-form">
                                        <div class="mb-2" t-if="not request.env.user._is_public()">
                                            <small class="text-muted"> Submitting as <t
                                                    t-esc="request.env.user.partner_id.name" />
                                            </small>
                                        </div>
                                        <t t-if="request.env.user._is_public()">
                                            <div class="mb-2">
                                                <label class="form-label small">Your Name</label>
                                                <input type="text" name="partner_name"
                                                    class="form-control" required="required" />
                                            </div>
                                            <div class="mb-2">
                                                <label class="form-label small">Your Email</label>
                                                <input type="email" name="partner_email"
                                                    class="form-control" required="required" />
                                            </div>
                                        </t>
                                        <div class="mb-3">
                                            <label class="form-label small">Your Offer</label>
                                            <input type="number" name="price" min="1" step="0.01"
                                                class="form-control" required="required" />
                                        </div>
                                        <button type="submit" class="btn btn-success w-100">
                                            <i class="fa fa-handshake-o me-1" /> Make an Offer </button>
                                    </form>
                                </t>
                                <t t-else="">
                                    <div class="alert alert-secondary mb-0">
                                        This property is no longer open for offers.
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>