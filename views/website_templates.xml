<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="property_list_template" name="Property List">
        <t t-call="website.layout">
            <div class="container my-5">
                <h1 class="mb-4">Available Properties</h1>
                <div class="row">
                    <t t-foreach="properties" t-as="prop">
                        <div class="col-md-4 mb-4">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        <t t-esc="prop.name" />
                                    </h5>
                                    <p class="card-text text-muted"> Expected Price: $<t
                                            t-esc="prop.expected_price" />
                                    </p>
                                    <a t-attf-href="/estate/property/#{prop.id}"
                                        class="btn btn-primary btn-sm">
                                        View Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <template id="property_detail_template" name="Property Detail">
        <t t-call="website.layout">
            <div class="container my-5">
                <a href="/estate/properties" class="btn btn-outline-secondary mb-3">&amp;lt; Back to
                    List</a>
                <h2>
                    <t t-esc="property.name" />
                </h2>
                <hr />
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Expected Price:</strong> $<t t-esc="property.expected_price" /></p>
                        <p>
                            <strong>Bedrooms:</strong>
                            <t t-esc="property.bedrooms" />
                        </p>
                        <p><strong>Living Area:</strong> <t t-esc="property.living_area" /> sq m</p>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>