<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="estate.EstateDashboard">
        <div class="o_action_manager p-4 bg-100 style-overflow-auto">
            <h3 class="mb-4 text-primary fw-bold">
                <i class="fa fa-dashboard me-2"/> Real Estate Analytics Dashboard
            </h3>

            <!-- Row 1: KPI Cards -->
            <div class="row g-3 mb-4">
                <div class="col-md-4" t-on-click="() => this.openProperties([], 'All Properties')">
                    <div class="card shadow-sm border-0 border-start border-4 border-primary p-3 cursor-pointer">
                        <div class="text-muted small">Total Properties</div>
                        <div class="h2 fw-bold mb-0" t-esc="state.totalProperties"/>
                    </div>
                </div>

                <div class="col-md-4" t-on-click="() => this.openProperties([['state', '=', 'sold']], 'Sold Properties')">
                    <div class="card shadow-sm border-0 border-start border-4 border-success p-3 cursor-pointer">
                        <div class="text-muted small">Sold Properties</div>
                        <div class="h2 fw-bold text-success mb-0" t-esc="state.soldProperties"/>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card shadow-sm border-0 border-start border-4 border-info p-3">
                        <div class="text-muted small">Total Sales Volume</div>
                        <div class="h2 fw-bold text-info mb-0">
                            <t t-esc="state.totalRevenue.toLocaleString()"/> JOD
                        </div>
                    </div>
                </div>
            </div>

            <!-- Row 2: Recent Offers Table -->
            <div class="card shadow-sm border-0 p-3">
                <h5 class="fw-bold mb-3"><i class="fa fa-list me-2"/> Recent Offers</h5>
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Property</th>
                            <th>Buyer</th>
                            <th>Price</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="state.recentOffers" t-as="offer" t-key="offer.id">
                            <td t-esc="offer.property_id[1]"/>
                            <td t-esc="offer.partner_id[1]"/>
                            <td class="fw-bold"><t t-esc="offer.price"/> JOD</td>
                            <td>
                                <span t-attf-class="badge bg-#{offer.status == 'accepted' ? 'success' : (offer.status == 'refused' ? 'danger' : 'warning')}">
                                    <t t-esc="offer.status"/>
                                </span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </t>

</templates>